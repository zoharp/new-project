# Orcanos Performance Testing Tool — Environment Variables

# === Backend ===

# Admin authentication (set a strong password)
ADMIN_PASSWORD=change-me

# Encryption key for storing account passwords (32-char hex string, generated with secrets.token_hex(16))
ENCRYPTION_KEY=change-me-32-char-hex-key

# FastAPI environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS configuration (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com

# Database (SQLite for local development)
DATABASE_URL=sqlite:///./orcanos_performance.db

# === Frontend (.env.local) ===

# Backend API URL
VITE_API_URL=http://localhost:8000

# App configuration
VITE_APP_NAME=Orcanos Performance Tool
VITE_SESSION_TIMEOUT_MINUTES=60
