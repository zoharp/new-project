# Cold Call Guide — Environment Configuration
# Copy this file to .env and fill in your actual Supabase credentials

# Supabase Configuration (REQUIRED)
# Get these from: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Development Settings
VITE_APP_ENV=development
VITE_DEBUG=false

# Application URL
VITE_APP_URL=http://localhost:3000

# Note:
# - VITE_* variables are exposed to the frontend (safe for anon key)
# - Do NOT add sensitive keys (like service role key) as VITE_ variables
# - VITE_SUPABASE_ANON_KEY is public; use RLS policies for security
